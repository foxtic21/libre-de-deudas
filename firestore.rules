rules_version = '2';
// Cada usuario solo puede leer y escribir SUS datos: users/{suUid} y sus movimientos.
// Nadie más (ni otros usuarios logueados) puede ver nada.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
